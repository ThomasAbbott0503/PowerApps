// =====================================================================
//  FATURAS ENDOLOG / LOGMED — MEDIDAS DAX
//  Como usar: Modelagem > Nova medida. As medidas com nome antigo
//  (VALORREAL, VALORDOLAR, tpmoeda, valorreallog, ValorEmUSDlogmed,
//  tpmoedalog) devem ser EDITADAS, não recriadas — assim os visuais
//  continuam funcionando.
//  Sugestão: crie uma tabela vazia "_Medidas" (Inserir dados) e mova
//  as medidas novas para ela (pasta "Endolog", "LOGMED", "Consolidado").
// =====================================================================


// ===================== ENDOLOG (tabela Fatura_Endolog) =====================

VALORREAL =
SUM ( Fatura_Endolog[COBRADO] )
// Formato: "R$" #,0

// CORRIGIDO: antes era COBRADO / 5,5 fixo e formatado como R$.
// Agora usa o PTAX médio de cada mês (coluna dDATAS[PTAX]).
VALORDOLAR =
SUMX (
    VALUES ( dDATAS[Data] ),
    DIVIDE ( [VALORREAL], CALCULATE ( MAX ( dDATAS[PTAX] ) ) )
)
// Formato: "US$" #,0

// CORRIGIDO: antes usava FORMAT() e devolvia TEXTO (quebrava totais,
// ordenação e gráficos). Agora devolve NÚMERO.
tpmoeda =
IF (
    SELECTEDVALUE ( TipoMoeda[Moeda], "Real" ) = "Real",
    [VALORREAL],
    [VALORDOLAR]
)
// Formato: Dinâmico  (Ferramentas de medida > Formato > Dinâmico) e cole:
//   IF ( SELECTEDVALUE ( TipoMoeda[Moeda], "Real" ) = "Real", """R$"" #,0", """US$"" #,0" )

Qtde Serviços Endolog =
SUM ( Fatura_Endolog[QTDE] )
// Formato: #,0

// NOVO: substitui a SOMA de PREÇO no gráfico "Tipo de serviço"
// (somar preço unitário não tem significado).
Preço Médio Endolog =
DIVIDE ( [VALORREAL], [Qtde Serviços Endolog] )
// Formato: "R$" #,0.00

Valor Mês Anterior Endolog =
VAR _Data = MAX ( dDATAS[Data] )
RETURN
    CALCULATE ( [VALORREAL], REMOVEFILTERS ( dDATAS ), dDATAS[Data] = EDATE ( _Data, -1 ) )
// Formato: "R$" #,0

Var % Mês Endolog =
VAR _Ant = [Valor Mês Anterior Endolog]
RETURN
    IF ( NOT ISBLANK ( _Ant ), DIVIDE ( [VALORREAL] - _Ant, _Ant ) )
// Formato: +0.0%;-0.0%;0.0%

Acumulado Ano Endolog =
VAR _Data = MAX ( dDATAS[Data] )
RETURN
    CALCULATE (
        [VALORREAL],
        REMOVEFILTERS ( dDATAS ),
        dDATAS[Ano] = YEAR ( _Data ),
        dDATAS[Data] <= _Data
    )
// Formato: "R$" #,0

Participação Filial Endolog =
DIVIDE ( [VALORREAL], CALCULATE ( [VALORREAL], ALLSELECTED ( FILIAISENDOLOG[FILIAL] ) ) )
// Formato: 0.0%


// ===================== LOGMED (tabela LOGMED-Serviços) =====================

valorreallog =
SUM ( 'LOGMED-Serviços'[Total] )
// Formato: "R$" #,0

// CORRIGIDO: antes era Total / 5,5 fixo.
ValorEmUSDlogmed =
SUMX (
    VALUES ( dDATAS[Data] ),
    DIVIDE ( [valorreallog], CALCULATE ( MAX ( dDATAS[PTAX] ) ) )
)
// Formato: "US$" #,0

// CORRIGIDO: agora devolve número (mesma lógica do tpmoeda).
tpmoedalog =
IF (
    SELECTEDVALUE ( TipoMoeda[Moeda], "Real" ) = "Real",
    [valorreallog],
    [ValorEmUSDlogmed]
)
// Formato dinâmico: igual ao tpmoeda

Qtde Serviços LOGMED =
SUM ( 'LOGMED-Serviços'[Quantidade] )
// Formato: #,0

Preço Médio LOGMED =
DIVIDE ( [valorreallog], [Qtde Serviços LOGMED] )
// Formato: "R$" #,0.00

Valor Mês Anterior LOGMED =
VAR _Data = MAX ( dDATAS[Data] )
RETURN
    CALCULATE ( [valorreallog], REMOVEFILTERS ( dDATAS ), dDATAS[Data] = EDATE ( _Data, -1 ) )

Var % Mês LOGMED =
VAR _Ant = [Valor Mês Anterior LOGMED]
RETURN
    IF ( NOT ISBLANK ( _Ant ), DIVIDE ( [valorreallog] - _Ant, _Ant ) )
// Formato: +0.0%;-0.0%;0.0%

Acumulado Ano LOGMED =
VAR _Data = MAX ( dDATAS[Data] )
RETURN
    CALCULATE (
        [valorreallog],
        REMOVEFILTERS ( dDATAS ),
        dDATAS[Ano] = YEAR ( _Data ),
        dDATAS[Data] <= _Data
    )


// ===================== CONSOLIDADO (Cost Drive / capa) =====================

Total Faturado =
[VALORREAL] + [valorreallog]
// Formato: "R$" #,0

Total Faturado Moeda =
[tpmoeda] + [tpmoedalog]
// Formato dinâmico: igual ao tpmoeda

Peso Endolog % =
DIVIDE ( [VALORREAL], [Total Faturado] )
// Formato: 0.0%

Período Selecionado =
VAR _Ini = MIN ( dDATAS[Data] )
VAR _Fim = MAX ( dDATAS[Data] )
RETURN
    "Período: " & FORMAT ( _Ini, "mmm/yy" ) & " a " & FORMAT ( _Fim, "mmm/yy" )
// Uso: título dinâmico no cabeçalho das páginas

// Data da última atualização: crie no Power Query uma consulta
// "Atualizacao" =  #table(type table [Data = datetime], {{DateTime.LocalNow()}})
// e use esta medida (NOW() em DAX mostraria a hora da consulta, não a da atualização):
Última Atualização =
"Atualizado em " & FORMAT ( MAX ( Atualizacao[Data] ), "dd/mm/yyyy hh:mm" )


// ===================== APAGAR =====================
// Medida "Medida" (tabela FRETES): não é usada e soma duas tabelas
// diferentes sem relação.
